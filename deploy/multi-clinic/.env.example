# Copy to ".env" (next to this docker-compose.yml) and edit before deploying.
# Generate every secret separately, e.g. `openssl rand -hex 32`. Use hex for
# the database passwords: they are placed in a connection URL unescaped.

# --- Shared ---
# GHCR image tag to deploy (from the Release workflow). "latest" by default.
IMAGE_TAG=latest
LOG_LEVEL=info
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1h
# Host directory with the TLS certificates (live/<domain>/fullchain.pem, privkey.pem).
CERTS_DIR=/etc/letsencrypt

# --- Clinic A ---
CLINIC_A_DOMAIN=clinic-a.example.com
CLINIC_A_DB_PASSWORD=change-me
CLINIC_A_JWT_SECRET=replace-with-a-long-random-secret-a

# --- Clinic B ---
CLINIC_B_DOMAIN=clinic-b.example.com
CLINIC_B_DB_PASSWORD=change-me
CLINIC_B_JWT_SECRET=replace-with-a-long-random-secret-b

# --- Clinic C ---
CLINIC_C_DOMAIN=clinic-c.example.com
CLINIC_C_DB_PASSWORD=change-me
CLINIC_C_JWT_SECRET=replace-with-a-long-random-secret-c

# --- Clinic D ---
CLINIC_D_DOMAIN=clinic-d.example.com
CLINIC_D_DB_PASSWORD=change-me
CLINIC_D_JWT_SECRET=replace-with-a-long-random-secret-d
