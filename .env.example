# Copy to ".env" (next to docker-compose.yml) and edit before deploying.
# Compose reads this file automatically. All values are required or have safe
# dev defaults in docker-compose.yml — secrets MUST be changed for production.

# --- PostgreSQL ---
POSTGRES_USER=oncall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oncall

# --- API secrets ---
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1h

# Set to "true" once served over HTTPS (terminates the cookie Secure flag).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Public origin of the web UI. Behind the bundled nginx proxy the browser and
# API share one origin, so CORS is effectively not exercised.
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
# Reverse proxies in front of the API: 1 = only the bundled web nginx,
# 2 = a TLS reverse proxy on the host in front of it.
TRUST_PROXY_HOPS=1

# --- Deployment ---
# Host address and port the web UI is published on. 127.0.0.1 keeps it
# reachable only from this host (for a TLS reverse proxy); Docker bypasses
# host firewalls such as ufw. Use 0.0.0.0 to serve browsers directly.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# GHCR image tag to deploy (from the Release workflow). "latest" by default.
IMAGE_TAG=latest
