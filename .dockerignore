# VCS & editor metadata
.git
.gitignore
.github
.vscode
.superpowers
.idea
.DS_Store

# Dependencies & build artifacts (regenerated inside the image)
**/node_modules
**/dist
**/coverage

# Env files (provided at runtime via the container environment)
**/.env
**/.env.*

# License signing keys & signed license files (mounted at runtime, never baked into images)
**/*.pem
license.json
**/license.json
**/*.license.json

# Logs
**/*.log
.pnpm-debug.log*

# Not needed inside the images
docs
database
*.md
LICENSE
