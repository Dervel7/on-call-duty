# Environment variables for a Render deployment (two Docker web services).
# Each service has its own variables: paste each section into that service's
# Environment tab (Render accepts "Add from .env"). Never commit real values.
#
# Do NOT set PORT on either service: Render injects it (default 10000) and both
# images bind 0.0.0.0:$PORT.

# =============================================================================
# Service 1: API  (Dockerfile path: apps/api/Dockerfile, build context: repo root)
# =============================================================================

NODE_ENV=production

# Neon connection string (Neon console > Connect). Use sslmode=verify-full:
# pg already treats "require" as verify-full and warns about the alias.
# Create the tables once before the first deploy (see "Database setup" below).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
# Format <n>h or <n>d only.
JWT_REFRESH_EXPIRES_IN=1h

# Render serves over HTTPS, so the refresh cookie must be Secure. The browser
# reaches the API through the web service's nginx (same origin), so lax works.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Public URL of the WEB service (from its dashboard), no trailing slash.
CORS_ORIGIN=https://your-web-service.onrender.com
LOG_LEVEL=info

# =============================================================================
# Service 2: Web  (Dockerfile path: apps/web/Dockerfile, build context: repo root)
# =============================================================================

# API service > Connect > Internal: copy the host exactly (it has a random
# suffix). Keep the http:// prefix and :10000, no trailing slash.
API_UPSTREAM=http://your-api-service-xxxx:10000

# =============================================================================
# Database setup (run once, from your machine, not on Render)
# =============================================================================
# The seed script drops and recreates the database named in DATABASE_URL, then
# applies database/schema.sql and the seed. Only run it on an empty database.
# An exported DATABASE_URL wins over apps/api/.env, so local dev is untouched.
#
# Use Neon's DIRECT endpoint here (Neon console > Connect, "Connection pooling"
# off: host without "-pooler"). DROP/CREATE DATABASE and schema changes should
# not go through the pooler. Keep the -pooler URL for the API on Render.
#
# PowerShell:
#   $env:DATABASE_URL="<Neon direct URL>"; pnpm db:seed:single; Remove-Item Env:DATABASE_URL
# bash:
#   DATABASE_URL="<Neon direct URL>" pnpm db:seed:single
#
# The seed creates demo accounts with known passwords: change them after login.
